# Every variable is optional and commented out. An empty value overrides the
# default, except for DATABASE_URL, which is read only when non-empty. The API
# does not load this file. Export the variables.

# Full connection URL. A non-empty value replaces the DB_* variables.
# DATABASE_URL=

# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# PDF_STORE is "local" or "s3".
# PDF_STORE=
# PDF_STORE_PATH=
# PDF_BUCKET=
# S3_ENDPOINT_URL=

# EMBEDDING_MODEL=
# EMBEDDING_CACHE_PATH=
# WORKER_ID=

# Answers. Without a key, POST /answer returns 503 and `reclamos answers`
# exits. DAILY_USD_CAP is US dollars per Lima calendar day, counted across every
# process that shares the database (docs/answers.md).
# ANTHROPIC_API_KEY=
# ANSWER_MODEL=
# JUDGE_MODEL=
# DAILY_USD_CAP=
# REFUSAL_MIN_SIMILARITY=

# A PostgreSQL server with pgvector for the integration tests.
# TEST_DATABASE_URL=
